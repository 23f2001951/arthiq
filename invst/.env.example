# invst environment configuration
# Copy to .env and fill in values

# Database path (default: db/invst.db)
INVST_DB_PATH=db/invst.db

# Data directories
INVST_DATA_RAW=data/raw
INVST_DATA_INTERIM=data/interim
INVST_DATA_PROCESSED=data/processed

# Logging level (DEBUG, INFO, WARNING, ERROR)
INVST_LOG_LEVEL=INFO

# Optional: Paid data vendor API keys (future)
# TIJORI_API_KEY=
# TRENDLYNE_API_KEY=
