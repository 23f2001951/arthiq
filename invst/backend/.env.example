# invst environment configuration
# Copy to .env and fill in values

# Database configuration
# Leave blank to use local SQLite (db/invst.db)
# Or set Neon Serverless PostgreSQL connection string for production:
DATABASE_URL=
INVST_DB_PATH=db/invst.db

# Data directories
INVST_DATA_RAW=data/raw
INVST_DATA_INTERIM=data/interim
INVST_DATA_PROCESSED=data/processed

# Logging level (DEBUG, INFO, WARNING, ERROR)
INVST_LOG_LEVEL=INFO

# Optional: Administrator bootstrap password (only used on initial empty DB setup)
ARTH_IQ_ADMIN_PASSWORD=
ARTH_IQ_ADMIN_EMAIL=admin@arth.iq
ARTH_IQ_SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
# For production, set this to the Cloudflare Pages site origin in Vercel.
ARTH_IQ_CORS_ORIGINS=http://localhost:5173
