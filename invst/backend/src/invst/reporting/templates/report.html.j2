<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Investment Recommendation Report — {{ asof_date }}</title>
    <style>
        {{ css_styles }}
    </style>
</head>
<body>
<div class="report-container">
    <div class="header">
        <h1>Personal Investment Decision-Support Report</h1>
        <div>
            <span class="meta-badge">Rebalance Date: {{ asof_date }}</span>
            <span class="meta-badge">Universe: Nifty 500</span>
            <span class="meta-badge">Holdings: {{ holdings|length }}</span>
            <span class="meta-badge">Run ID: {{ run_id[:8] }}</span>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-title">Holdings Target</div>
            <div class="kpi-value">{{ holdings|length }} Stocks</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Max Stock Cap</div>
            <div class="kpi-value">25.0%</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Max Sector Cap</div>
            <div class="kpi-value">40.0%</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Rebalance Cadence</div>
            <div class="kpi-value">Quarterly</div>
        </div>
    </div>

    <h2>Portfolio Recommendations</h2>

    {% for item in holdings %}
    <div class="stock-card">
        <div class="stock-header">
            <div>
                <span class="stock-title">{{ item.symbol }}</span> — <small>{{ item.sector.replace('_', ' ').title() }}</small>
            </div>
            <div>
                <span class="action-badge action-{{ item.action.lower() }}">{{ item.action }}</span>
                <strong>{{ (item.target_weight * 100)|round(1) }}%</strong> target
            </div>
        </div>

        <div class="rationale-box">
            <strong>Why we like it:</strong><br>
            {{ item.rationale }}
        </div>

        <table class="metrics-table">
            <tr>
                <th>Composite Score</th>
                <th>Quality Score</th>
                <th>Valuation Score</th>
                <th>Risk Score</th>
                <th>Sentiment Overlay</th>
            </tr>
            <tr>
                <td><strong>{{ item.scorecard.composite_score }} / 100</strong></td>
                <td>{{ item.scorecard.quality_score }}</td>
                <td>{{ item.scorecard.valuation_score }}</td>
                <td>{{ item.scorecard.risk_score }}</td>
                <td>{{ item.scorecard.sentiment_overlay_points }} pts</td>
            </tr>
        </table>
    </div>
    {% endfor %}

    <div style="margin-top: 32px; font-size: 11px; color: #a0aec0; text-align: center; border-top: 1px solid #edf2f7; padding-top: 16px;">
        Generated by invst decision-support tool. Personal use only. Trade execution is strictly manual.
    </div>
</div>
</body>
</html>
